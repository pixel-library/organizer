{
  "name": "life-organizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node tests/functional.mjs",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "db:start": "node server/db/embedded.js",
    "db:migrate": "node-pg-migrate up --migrations-dir server/db/migrations --envPath .env",
    "db:down": "node-pg-migrate down --migrations-dir server/db/migrations --envPath .env",
    "db:rebuild": "node-pg-migrate down --migrations-dir server/db/migrations --envPath .env && node-pg-migrate up --migrations-dir server/db/migrations --envPath .env",
    "test:db": "node tests/db.test.mjs",
    "test:auth": "node tests/auth.test.mjs",
    "test:profile": "node tests/profile.test.mjs",
    "test:tasks": "node tests/tasks.test.mjs",
    "test:notes": "node tests/notes.test.mjs",
    "test:calendar": "node tests/calendar.test.mjs",
    "test:stats": "node tests/stats.test.mjs",
    "test:collections": "node tests/collections.test.mjs",
    "test:security": "node tests/security.test.mjs",
    "test:complete": "node tests/complete.test.mjs",
    "test:admin": "node tests/admin.test.mjs",
    "test:admin:api": "node tests/admin-api.test.mjs",
    "test:admin:browse": "node tests/admin-browse.test.mjs",
    "test:admin:sql": "node tests/admin-sql.test.mjs",
    "test:admin:backup": "node tests/admin-backup.test.mjs",
    "admin": "node scripts/admin.js",
    "admin:init": "node scripts/admin-init.js",
    "admin:sql": "node scripts/admin.js --sql",
    "admin:export": "node scripts/admin-export.js",
    "admin:view": "node scripts/admin-view.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
