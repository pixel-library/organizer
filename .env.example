# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# CORS
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection — used by the API and by node-pg-migrate.
# When DATABASE_URL is unset the API builds it from the DB_* values below.
DATABASE_URL=postgres://life_organizer:life_organizer@localhost:5432/life_organizer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=life_organizer
DB_USER=life_organizer
DB_PASSWORD=life_organizer

# Local embedded PostgreSQL (npm run db:start) — development only.
# The embedded server creates the role/database from DB_USER/DB_NAME/DB_PASSWORD.
PG_DATA_DIR=.pgdata
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres
