# ============================================================
# Life Organizer — environment configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Session lifetime (minutes) for authentication cookies
SESSION_TTL_MINUTES=10080

# ---- Rate limiting (requests per IP per 15-minute window) ----
# Authentication endpoints (login/register) get a stricter default limit.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_ADMIN_MAX=300

# ---- Brute-force protection (login) ----
# Lock a username for LOGIN_LOCK_MINUTES after LOGIN_MAX_FAILS failed logins.
# The lockout is in-memory (per process) and per-username, on top of the
# per-IP rate limit above.
LOGIN_MAX_FAILS=10
LOGIN_LOCK_MINUTES=15

# ---- CORS ----
# Comma-separated list of allowed browser origins.
# REQUIRED in production (the server refuses to start without it).
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL connection ----
# Used by the API and by node-pg-migrate.
# When DATABASE_URL is unset the API builds it from the DB_* values below.
DATABASE_URL=postgres://life_organizer:life_organizer@localhost:5432/life_organizer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=life_organizer
DB_USER=life_organizer
DB_PASSWORD=life_organizer

# Local embedded PostgreSQL (npm run db:start) — development only.
# The embedded server creates the role/database from DB_USER/DB_NAME/DB_PASSWORD.
PG_DATA_DIR=.pgdata
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres

# ---- Frontend (Vite) ----
# Public API base used by the SPA (baked in at build time).
# Keep "/api" when the API is served from the same origin (or when using the
# dev proxy below); set an absolute URL for a separate API host, e.g.
#   VITE_API_URL=https://api.example.com/api
VITE_API_URL=/api

# Dev proxy target for /api (vite dev server only).
VITE_PROXY_TARGET=http://localhost:4000